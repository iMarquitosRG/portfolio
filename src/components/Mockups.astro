---
/**
 * Large device + phone. Real screens when `images` is set (files in src/assets/cases), placeholders otherwise.
 * Optional screenLight / phoneLight swap in with the light theme.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Shots { screen: string; phone: string; screenLight?: string; phoneLight?: string }
interface Props { class?: string; parallax?: number; images?: Shots }
const { class: cls, parallax, images } = Astro.props;
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/cases/*.{png,jpg,jpeg,webp,avif}');
const load = async (name?: string) => {
  const key = name ? `../assets/cases/${name}` : '';
  return key && files[key] ? (await files[key]()).default : null;
};
const screen = await load(images?.screen);
const phone = await load(images?.phone);
const screenL = await load(images?.screenLight);
const phoneL = await load(images?.phoneLight);
---
<div class:list={['mockups', cls]} aria-hidden="true" data-parallax={parallax}>
  <div class:list={['mock mock--tablet', screen && 'mock--img']}>
    {screen && <Image class:list={[screenL && 'mock__img--dark']} src={screen} alt="" widths={[400, 800, 1200]} sizes="(min-width: 1200px) 520px, 70vw" />}
    {screenL && <Image class="mock__img--light" src={screenL} alt="" widths={[400, 800, 1200]} sizes="(min-width: 1200px) 520px, 70vw" />}
  </div>
  <div class:list={['mock mock--phone', phone && 'mock--img']}>
    {phone && <Image class:list={[phoneL && 'mock__img--dark']} src={phone} alt="" widths={[160, 320]} sizes="160px" />}
    {phoneL && <Image class="mock__img--light" src={phoneL} alt="" widths={[160, 320]} sizes="160px" />}
  </div>
</div>
