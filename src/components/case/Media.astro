---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { label: string; src?: string; srcLight?: string; alt?: string; height?: 'sm' | 'md' | 'lg'; tint?: boolean; backdrop?: boolean }
const { label, src, srcLight, alt = '', height = 'md', tint = true, backdrop = false } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('../../assets/cases/*.{png,jpg,jpeg,webp,avif}');
const key = src ? `../../assets/cases/${src}` : null;
const img = key && images[key] ? (await images[key]()).default : null;
const keyL = srcLight ? `../../assets/cases/${srcLight}` : null;
const imgL = keyL && images[keyL] ? (await images[keyL]()).default : null;
---
<figure class:list={['media', `media--${height}`, tint && !img && 'media--tint', img && 'media--img', img && backdrop && 'media--backdrop']} data-reveal>
  {img ? (
    <>
      <Image class:list={[imgL && 'media__img--dark']} src={img} alt={alt} widths={[480, 800, 1200, 1600, 2400]} quality={90} sizes="(min-width: 1200px) 1000px, 100vw" />
      {imgL && <Image class="media__img--light" src={imgL} alt={alt} widths={[480, 800, 1200, 1600, 2400]} quality={90} sizes="(min-width: 1200px) 1000px, 100vw" />}
    </>
  ) : (
    <figcaption class="media__label t-label">Placeholder · {label}</figcaption>
  )}
</figure>
